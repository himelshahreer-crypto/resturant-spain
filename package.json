{
  "name": "kebab-factory-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/serve-static.mjs out 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "fonts": "node scripts/fetch-fonts.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "extract:content": "node scripts/extract-content.mjs",
    "codemod": "node scripts/codemod/template-to-jsx.mjs",
    "images": "node scripts/optimize-images.mjs",
    "brand": "node scripts/make-brand-images.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "parse5": "^7.3.0",
    "prettier": "^3.9.9",
    "react-dom18-umd": "npm:react-dom@18.3.1",
    "react18-umd": "npm:react@18.3.1",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  }
}
